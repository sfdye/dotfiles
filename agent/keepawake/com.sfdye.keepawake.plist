<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.sfdye.keepawake</string>

    <!-- Reconcile desired vs. actual state every 60s: self-heals missed Stop
         hooks, dead agent PIDs, expired holds, and post-reboot leftover state.
         install.sh rewrites __HOME__ to the real home directory. -->
    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/.local/bin/keepawake</string>
        <string>sweep</string>
    </array>

    <key>RunAtLoad</key>
    <true/>
    <key>StartInterval</key>
    <integer>60</integer>

    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/keepawake.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/keepawake.log</string>
</dict>
</plist>
