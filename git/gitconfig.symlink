# Local/private config goes in the include
[include]
  path = ~/.gitconfig.local
  path = ~/.gitconfig.private
[alias]
  # `co main`/`co master` resolve to the repo's actual default branch
  co = "!f() { if [ \"$1\" = main ] || [ \"$1\" = master ]; then def=$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null | sed 's@^origin/@@'); if [ -z \"$def\" ]; then if git show-ref --verify --quiet refs/heads/main; then def=main; elif git show-ref --verify --quiet refs/heads/master; then def=master; else def=$1; fi; fi; shift; git checkout \"$def\" \"$@\"; else git checkout \"$@\"; fi; }; f"
  ci = commit
  br = branch
  st = status
  df = diff
  bclean="!f() { git branch --merged ${1-main} | grep -v " ${1-main}$" | xargs git branch -d; }; f"
[color]
  diff = auto
  status = auto
  branch = auto
  interactive = auto
  ui = true
[core]
  excludesfile = ~/.gitignore
  editor = vim
  pager = delta
[apply]
  whitespace = nowarn
[diff]
  submodule = log
  tool = meld
[difftool]
  prompt = false
[difftool "meld"]
  trustExitCode = true
  cmd = /Applications/Meld.app/Contents/MacOS/Meld \"$LOCAL\" \"$REMOTE\"
[merge]
  tool = meld
[mergetool]
  prompt = false
[mergetool "meld"]
  trustExitCode = true
  cmd = /Applications/Meld.app/Contents/MacOS/Meld --args --auto-merge \"$LOCAL\" \"$BASE\" \"$REMOTE\" --output=\"$MERGED\"
[help]
  autocorrect = 1
[push]
  default = simple
  recurseSubmodules = on-demand
[status]
	submoduleSummary = true
[pull]
	ff = only
  rebase = true
	recurseSubmodules = no
[rebase]
  autostash = true
[blame]
	markignoredlines = true
[branch]
	sort = -committerdate
[interactive]
  diffFilter = delta --color-only
[sequence]
	editor = interactive-rebase-tool
[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
[url "git@github.com:"]
 insteadOf = https://github.com/
[credential]
	helper = /usr/local/share/gcm-core/git-credential-manager
[credential "https://dev.azure.com"]
	useHttpPath = true
